<Window x:Class="NotionPad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NotionPad.Views"
        Title="Notion Pad"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <views:SyncStateToBrushConverter x:Key="StateBrush" />
    <views:SyncStateToLabelConverter x:Key="StateLabel" />
    <views:ErrorVisibilityConverter x:Key="ErrorVis" />
    <views:NullToVisibilityConverter x:Key="NullVis" />
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
          <Grid>
            <TextBlock Text="Notion Pad" FontWeight="SemiBold" FontSize="13" />
            <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" ToolTip="Settings"
                    Click="OnOpenSettings" />
          </Grid>
        </Border>

        <Button Grid.Row="1" x:Name="NewNoteButton" Content="+ New note"
                Style="{StaticResource FlatButton}" Margin="10,10,10,6"
                Click="OnCreateNote" />

        <ListBox x:Name="NotesList" Grid.Row="2" Margin="6,4,6,8"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch"
                 SelectionChanged="OnNoteSelected">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="4" Padding="10,8">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelBrush}" />
                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="6,0,4,0"
                           Fill="{Binding SyncState, Converter={StaticResource StateBrush}}" />
                  <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                             Text="{Binding SyncState, Converter={StaticResource StateLabel}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Style="{StaticResource MutedText}"
                           Text="{Binding Body}" TextTrimming="CharacterEllipsis"
                           MaxHeight="16" Margin="0,2,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Editor -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
        <StackPanel>
          <Grid>
            <TextBlock x:Name="TitleLabel" FontSize="16" FontWeight="SemiBold"
                       Text="No note selected" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Ellipse x:Name="StateDot" Width="9" Height="9" Margin="0,0,6,0" Fill="{StaticResource MutedBrush}" />
              <TextBlock x:Name="StateText" Style="{StaticResource MutedText}" Text="" VerticalAlignment="Center" />
              <Button x:Name="RetryButton" Content="Retry" Margin="12,0,0,0"
                      Style="{StaticResource GhostButton}" Foreground="{StaticResource AccentBrush}"
                      Visibility="Collapsed" Click="OnRetry" />
              <Button x:Name="CopyErrorButton" Content="Copy error" Margin="6,0,0,0"
                      Style="{StaticResource GhostButton}" Foreground="{StaticResource MutedBrush}"
                      Visibility="Collapsed" Click="OnCopyError" />
              <Button x:Name="DeleteButton" Content="Delete" Margin="6,0,0,0"
                      Style="{StaticResource GhostButton}" Foreground="{StaticResource ErrorBrush}"
                      IsEnabled="False" Click="OnDeleteNote" />
            </StackPanel>
          </Grid>
          <Border x:Name="ErrorBanner" Visibility="Collapsed" Margin="0,8,0,0"
                  Background="#3a1a1a" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="10,6">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}"
                       TextWrapping="Wrap" FontSize="12" />
          </Border>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1">
        <TextBox x:Name="EditorBox"
                 Background="{StaticResource BgBrush}"
                 Foreground="{StaticResource TextBrush}"
                 CaretBrush="{StaticResource TextBrush}"
                 BorderThickness="0" Padding="24,18"
                 FontSize="14" FontFamily="Segoe UI"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" SpellCheck.IsEnabled="True"
                 VerticalScrollBarVisibility="Auto"
                 IsEnabled="False"
                 TextChanged="OnEditorTextChanged" />
        <TextBlock x:Name="EmptyHint" Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Text="Select or create a note to start writing" />
      </Grid>
    </Grid>
  </Grid>
</Window>
